# Archive Server Configuration

# Environment
NODE_ENV=development

# Server Configuration
PORT=3443
ALLOWED_ORIGINS=https://localhost:3000,https://eng.dev.seibtribe.us

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=engage2_archive_dev
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Production Database SSL Configuration (only for production)
# DB_SSL_CA=/path/to/ca-cert.pem
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem

# mTLS Configuration
# Server certificates
MTLS_SERVER_KEY=/path/to/server-key.pem
MTLS_SERVER_CERT=/path/to/server-cert.pem
MTLS_CA_CERT=/path/to/ca-cert.pem

# Allowed client certificates (comma-separated)
MTLS_ALLOWED_CLIENTS=engage2-dev-client,engage2-test-client,engage2-prod-client,engage2-admin-client

# Logging Configuration
LOG_LEVEL=info
LOG_ACCESS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Security
HELMET_CSP_ENABLED=true
CORS_ENABLED=true

# Performance
COMPRESSION_ENABLED=true
REQUEST_SIZE_LIMIT=10mb

# Audit Log Retention
AUDIT_LOG_RETENTION_DAYS=90

# Development Settings (development only)
DEV_SKIP_MTLS=false
DEV_MOCK_CLIENT=false