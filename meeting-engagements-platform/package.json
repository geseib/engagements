{
  "name": "meeting-engagements-platform",
  "version": "1.0.0",
  "description": "Interactive meeting engagement platform with real-time collaboration",
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "npm run build --workspaces --if-present",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec ts-node src/local/server.ts",
    "dev:frontend": "npm run dev --workspaces --if-present",
    "deploy:dev": "cdk deploy --all --profile dev --require-approval never",
    "deploy:test": "cdk deploy --all --profile test --require-approval never",
    "deploy:prod": "cdk deploy --all --profile prod",
    "destroy:dev": "cdk destroy --all --profile dev --force",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "setup": "npm run setup:deps && npm run setup:git && npm run setup:env",
    "setup:deps": "npm install && npm run install:workspaces",
    "setup:git": "husky install",
    "setup:env": "cp .env.example .env.local",
    "install:workspaces": "npm install --workspaces",
    "clean": "rimraf dist coverage .nyc_output",
    "prepare": "husky install"
  },
  "workspaces": [
    "frontend/host-dashboard",
    "frontend/participant-app", 
    "frontend/admin-portal",
    "frontend/shared"
  ],
  "keywords": [
    "engagement",
    "meetings",
    "trivia",
    "polls",
    "surveys",
    "real-time",
    "aws",
    "serverless"
  ],
  "author": "George Seib <george@seibtribe.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "aws-cdk": "^2.108.0",
    "aws-cdk-lib": "^2.108.0",
    "concurrently": "^8.2.2",
    "constructs": "^10.3.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.454.0",
    "@aws-sdk/client-s3": "^3.454.0",
    "@aws-sdk/lib-dynamodb": "^3.454.0",
    "@aws-sdk/util-dynamodb": "^3.454.0",
    "aws-lambda": "^1.0.7",
    "pdfkit": "^0.14.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/tests"],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/local/**",
      "!src/types/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.ts"]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
