// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`create, call-and-answer, with a set picked 1`] = `"<div class="form-group"><label for="gsd-title">Event title</label><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" value="Q3 Offsite"></div><div class="form-group"><span class="gsd-label" id="gsd-format-label">Format</span><div class="gsd-types" role="group" aria-labelledby="gsd-format-label"><button type="button" class="gsd-pill on" aria-pressed="true">Call &amp; Answer</button><button type="button" class="gsd-pill" aria-pressed="false">Trivia</button><button type="button" class="gsd-pill" aria-pressed="false">Poll</button><button type="button" class="gsd-pill" aria-pressed="false">Wavelength</button><button type="button" class="gsd-pill" aria-pressed="false">Survey</button></div><p class="gsd-blurb">Open responses, then the room votes on the best ones.</p></div><div class="gsd-row"><div class="form-group"><label for="gsd-set">Question set</label><select id="gsd-set" class="dialog-select"><option value="">Select a question set...</option><option value="platform:pricing">Strategic Pricing Plays (47 questions)</option></select><button type="button" class="gsd-setlink">Your question sets</button></div><div class="form-group"><span class="gsd-label" id="gsd-categories-label">Categories</span><div class="category-selection"><div class="category-button-grid" role="group" aria-labelledby="gsd-categories-label"><button type="button" class="category-button " aria-pressed="false"><span class="category-name">Leadership</span><span class="category-count">(20)</span></button><button type="button" class="category-button selected" aria-pressed="true"><span class="category-name">Ops</span><span class="category-count">(27)</span></button></div><small class="dialog-help-text">1 of 2 categories · 27 questions</small></div></div></div><h3 class="gsd-section">Workie’s briefing<span class="gsd-tag">Call &amp; Answer only</span></h3><div class="gsd-brief"><input type="file" accept=".pdf,.docx,.txt,.md,.pptx,.ppt,.key,.odp" class="gsd-brief-file" tabindex="-1" aria-hidden="true"><span class="gsd-brief-ico"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" class="ws-icon"><path d="M216.49,79.52l-56-56A12,12,0,0,0,152,20H56A20,20,0,0,0,36,40V216a20,20,0,0,0,20,20H200a20,20,0,0,0,20-20V88A12,12,0,0,0,216.49,79.52ZM160,57l23,23H160ZM60,212V44h76V92a12,12,0,0,0,12,12h48V212Zm112-80a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,132Zm0,40a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,172Z"></path></svg></span><div class="gsd-brief-main"><p class="gsd-brief-t">Brief Workie from a document <span class="gsd-fine">— optional</span></p><p class="gsd-brief-d">A report, a review, a plan: whatever explains the situation this session is about. Workie gets a short summary of it — you read and can edit it first — and uses it when it reflects the room’s answers. <b>People who join never see it.</b></p><div class="gsd-brief-acts"><button type="button" class="gsd-btn"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon"><path d="M228,144v64a12,12,0,0,1-12,12H40a12,12,0,0,1-12-12V144a12,12,0,0,1,24,0v52H204V144a12,12,0,0,1,24,0ZM96.49,80.49,116,61v83a12,12,0,0,0,24,0V61l19.51,19.52a12,12,0,1,0,17-17l-40-40a12,12,0,0,0-17,0l-40,40a12,12,0,1,0,17,17Z"></path></svg>Choose a document</button><span class="gsd-fine">PDF, Word or text · up to 4 MB</span><button type="button" class="gsd-btn gsd-btn--link">or write the key points yourself</button></div></div></div><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-testid="gsd-adv-summary">Using the defaults — answers anonymous until voting closes, questions shuffled; Workie adapts its voice and follows this set’s own summary approach.<span class="gsd-adv-open-only"> Change any of them here.</span></span></summary><div class="gsd-adv-body"><h3 class="gsd-section">Responses</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Anonymous responses</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Until voting closes, nobody sees who wrote which answer — not the room, not you. The room votes on the answers, not on the people. You can also reveal the names earlier if you want to.</p><div class="gsd-preview"><div class="gsd-pv"><h6>While voting</h6><p class="gsd-pv-ans">“Freeze all discretionary discounting for thirty days…”</p><p class="gsd-pv-who">Response 1</p></div><div class="gsd-pv"><h6>After voting closes</h6><p class="gsd-pv-ans">“Freeze all discretionary discounting for thirty days…”</p><p class="gsd-pv-who named">Priya Raghavan · +180 pts</p></div></div><p class="gsd-opt-else"><b>Turn it off</b> and every answer is labelled with its author from the moment voting opens.</p><p class="gsd-opt-limit">This hides names, not identities. In a small group, people may still recognise each other’s answers.</p></div><h3 class="gsd-section">Questions</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Shuffle the question order</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Questions are drawn at random from the categories you picked, rather than in the order they were written.</p></div><h3 class="gsd-section">Workie</h3><div class="form-group"><label for="gsd-persona">Workie's voice</label><select id="gsd-persona" class="dialog-select"><option value="">Adapt to the session (recommended)</option><option value="coach">Coach — warm and direct</option></select><small class="dialog-help-text">Workie reads the room and picks its own register — playful for an icebreaker, analytical for a retro.</small></div><div class="form-group"><label for="gsd-prompt">Summary approach</label><select id="gsd-prompt" class="dialog-select"><option value="">What the set says (recommended)</option><option value="lp-behavioral">LP Behavioural</option></select><small class="dialog-help-text">How Workie sums up each round on the results screen — the shape and content, where the voice is only the register. You can change it mid-session; it applies from the next round.</small></div><div class="form-group"><label for="gsd-ai-context">Instructions for Workie</label><textarea id="gsd-ai-context" placeholder="Anything Workie must always do — e.g. ‘end every round with one question for the ops leads’" class="dialog-textarea" rows="2" maxlength="500"></textarea><small class="dialog-help-text">Workie follows these in every round’s summary. Facts about the session belong in Event details, below. 0/500 characters</small></div><h3 class="gsd-section">What people see when they join</h3><div class="form-group"><label for="gsd-details">Event details</label><textarea id="gsd-details" placeholder="What this session is for, in a sentence or two." class="dialog-textarea" rows="2" maxlength="300"></textarea><small class="dialog-help-text">Shown to people on the screen they land on after joining. Workie reads it too. 0/300 characters</small></div></div></details>"`;

exports[`create, poll, with a set picked 1`] = `"<div class="form-group"><label for="gsd-title">Event title</label><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" value="Q3 Offsite"></div><div class="form-group"><span class="gsd-label" id="gsd-format-label">Format</span><div class="gsd-types" role="group" aria-labelledby="gsd-format-label"><button type="button" class="gsd-pill" aria-pressed="false">Call &amp; Answer</button><button type="button" class="gsd-pill" aria-pressed="false">Trivia</button><button type="button" class="gsd-pill on" aria-pressed="true">Poll</button><button type="button" class="gsd-pill" aria-pressed="false">Wavelength</button><button type="button" class="gsd-pill" aria-pressed="false">Survey</button></div><p class="gsd-blurb">Gauge opinion — no right answer, distribution is the result.</p></div><div class="gsd-row"><div class="form-group"><label for="gsd-set">Question set</label><select id="gsd-set" class="dialog-select"><option value="">Select a question set...</option><option value="platform:mood">Room Mood (6 questions)</option></select><button type="button" class="gsd-setlink">Your question sets</button></div><div class="form-group"><span class="gsd-label" id="gsd-categories-label">Categories</span><div class="category-selection"><div class="category-button-grid" role="group" aria-labelledby="gsd-categories-label"><button type="button" class="category-button " aria-pressed="false"><span class="category-name">Leadership</span><span class="category-count">(20)</span></button><button type="button" class="category-button selected" aria-pressed="true"><span class="category-name">Ops</span><span class="category-count">(27)</span></button></div><small class="dialog-help-text">1 of 2 categories · 27 questions</small></div></div></div><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-testid="gsd-adv-summary">Using the defaults — answers anonymous until voting closes, questions shuffled; Workie adapts its voice and gives the standard Poll summary.<span class="gsd-adv-open-only"> Change any of them here.</span></span></summary><div class="gsd-adv-body"><h3 class="gsd-section">Responses</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Anonymous responses</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Until voting closes, nobody sees who wrote which answer — not the room, not you. The room votes on the answers, not on the people. You can also reveal the names earlier if you want to.</p><div class="gsd-preview"><div class="gsd-pv"><h6>While voting</h6><p class="gsd-pv-ans">“Freeze all discretionary discounting for thirty days…”</p><p class="gsd-pv-who">Response 1</p></div><div class="gsd-pv"><h6>After voting closes</h6><p class="gsd-pv-ans">“Freeze all discretionary discounting for thirty days…”</p><p class="gsd-pv-who named">Priya Raghavan · +180 pts</p></div></div><p class="gsd-opt-else"><b>Turn it off</b> and every answer is labelled with its author from the moment voting opens.</p><p class="gsd-opt-limit">This hides names, not identities. In a small group, people may still recognise each other’s answers.</p></div><h3 class="gsd-section">Questions</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Shuffle the question order</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Questions are drawn at random from the categories you picked, rather than in the order they were written.</p></div><h3 class="gsd-section">Workie</h3><div class="form-group"><label for="gsd-persona">Workie's voice</label><select id="gsd-persona" class="dialog-select"><option value="">Adapt to the session (recommended)</option><option value="coach">Coach — warm and direct</option></select><small class="dialog-help-text">Workie reads the room and picks its own register — playful for an icebreaker, analytical for a retro.</small></div><div class="form-group"><label for="gsd-prompt">Summary approach</label><select id="gsd-prompt" class="dialog-select"><option value="">The standard Poll way (recommended)</option></select><small class="dialog-help-text">How Workie sums up each round on the results screen — the shape and content, where the voice is only the register. You can change it mid-session; it applies from the next round.</small></div><div class="form-group"><label for="gsd-ai-context">Instructions for Workie</label><textarea id="gsd-ai-context" placeholder="Anything Workie must always do — e.g. ‘end every round with one question for the ops leads’" class="dialog-textarea" rows="2" maxlength="500"></textarea><small class="dialog-help-text">Workie follows these in every round’s summary. Facts about the session belong in Event details, below. 0/500 characters</small></div><h3 class="gsd-section">What people see when they join</h3><div class="form-group"><label for="gsd-details">Event details</label><textarea id="gsd-details" placeholder="What this session is for, in a sentence or two." class="dialog-textarea" rows="2" maxlength="300"></textarea><small class="dialog-help-text">Shown to people on the screen they land on after joining. Workie reads it too. 0/300 characters</small></div></div></details>"`;

exports[`create, survey, with a set picked 1`] = `"<div class="form-group"><label for="gsd-title">Event title</label><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" value="Q3 Offsite"></div><div class="form-group"><span class="gsd-label" id="gsd-format-label">Format</span><div class="gsd-types" role="group" aria-labelledby="gsd-format-label"><button type="button" class="gsd-pill" aria-pressed="false">Call &amp; Answer</button><button type="button" class="gsd-pill" aria-pressed="false">Trivia</button><button type="button" class="gsd-pill" aria-pressed="false">Poll</button><button type="button" class="gsd-pill" aria-pressed="false">Wavelength</button><button type="button" class="gsd-pill on" aria-pressed="true">Survey</button></div><p class="gsd-blurb">Structured multi-question feedback, reported in aggregate.</p></div><div class="gsd-row"><div class="form-group"><label for="gsd-set">Question set</label><select id="gsd-set" class="dialog-select"><option value="">Select a question set...</option><option value="platform:pulse">Kickoff pulse (5 questions)</option></select><button type="button" class="gsd-setlink">Your question sets</button></div></div><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-testid="gsd-adv-summary">Using the defaults — who finished recorded, never their answers (this set’s default).<span class="gsd-adv-open-only"> Change any of them here.</span></span></summary><div class="gsd-adv-body"><h3 class="gsd-section">Responses</h3><div class="gsd-names"><div class="gsd-names-hd"><span class="gsd-opt-name">Names</span><span class="gsd-names-st" aria-hidden="true">Who finished</span></div><div class="gsd-three" role="radiogroup" aria-label="Names"><button type="button" role="radio" aria-checked="false" tabindex="-1" class="gsd-three-opt"><b><i aria-hidden="true"></i>Anonymous</b><span>Nobody is recorded. The host sees totals and the words people write.</span></button><button type="button" role="radio" aria-checked="true" tabindex="0" class="gsd-three-opt"><b><i aria-hidden="true"></i>Who finished</b><span>The host sees who finished, never what they answered.</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="gsd-three-opt"><b><i aria-hidden="true"></i>Named</b><span>The host sees each person’s name with their answers. The room never does.</span></button></div><p class="gsd-opt-does">You will see a list of who finished and who stopped partway. Their answers are stored apart from their names, so nobody — you included — can match an answer to a person.</p><div class="gsd-preview"><div class="gsd-pv"><h6>What their phone says</h6><p class="gsd-pv-ans" data-testid="names-phone-preview">Your host sees that you finished — not what you answered.</p></div><div class="gsd-pv"><h6>What you get</h6><p class="gsd-pv-ans">“Seeing the console actually run beat every slide about it.”</p><p class="gsd-pv-who">Response 12 · no name</p><p class="gsd-pv-ans gsd-pv-gap">Priya Raghavan · finished 2:12pm</p><p class="gsd-pv-who">People list · no answers</p></div></div><p class="gsd-opt-limit">This hides names, not identities. In a small group, people may still recognise each other’s answers.</p></div><p class="gsd-names-lock"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon"><path d="M208,76H180V56A52,52,0,0,0,76,56V76H48A20,20,0,0,0,28,96V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V96A20,20,0,0,0,208,76ZM100,56a28,28,0,0,1,56,0V76H100ZM204,204H52V100H204Zm-60-52a16,16,0,1,1-16-16A16,16,0,0,1,144,152Z"></path></svg> Fixed once the survey opens — people answer on the promise their phone made them. This set’s default is <b>Who finished</b>.</p><h3 class="gsd-section">Workie</h3><div class="form-group"><label for="gsd-persona">Workie's voice</label><select id="gsd-persona" class="dialog-select"><option value="">Adapt to the session (recommended)</option><option value="coach">Coach — warm and direct</option></select><small class="dialog-help-text">Workie reads the room and picks its own register — playful for an icebreaker, analytical for a retro.</small></div><div class="form-group"><label for="gsd-prompt">Summary approach</label><select id="gsd-prompt" class="dialog-select"><option value="">The standard Survey way (recommended)</option></select><small class="dialog-help-text">How Workie sums up each round on the results screen — the shape and content, where the voice is only the register. You can change it mid-session; it applies from the next round.</small></div><div class="form-group"><label for="gsd-ai-context">Instructions for Workie</label><textarea id="gsd-ai-context" placeholder="Anything Workie must always do — e.g. ‘end every round with one question for the ops leads’" class="dialog-textarea" rows="2" maxlength="500"></textarea><small class="dialog-help-text">Workie follows these in every round’s summary. Facts about the session belong in Event details, below. 0/500 characters</small></div><h3 class="gsd-section">What people see when they join</h3><div class="form-group"><label for="gsd-details">Event details</label><textarea id="gsd-details" placeholder="What this session is for, in a sentence or two." class="dialog-textarea" rows="2" maxlength="300"></textarea><small class="dialog-help-text">Shown to people on the screen they land on after joining. Workie reads it too. 0/300 characters</small></div></div></details>"`;

exports[`create, trivia, with a set picked 1`] = `"<div class="form-group"><label for="gsd-title">Event title</label><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" value="Q3 Offsite"></div><div class="form-group"><span class="gsd-label" id="gsd-format-label">Format</span><div class="gsd-types" role="group" aria-labelledby="gsd-format-label"><button type="button" class="gsd-pill" aria-pressed="false">Call &amp; Answer</button><button type="button" class="gsd-pill on" aria-pressed="true">Trivia</button><button type="button" class="gsd-pill" aria-pressed="false">Poll</button><button type="button" class="gsd-pill" aria-pressed="false">Wavelength</button><button type="button" class="gsd-pill" aria-pressed="false">Survey</button></div><p class="gsd-blurb">Multiple choice with one correct answer and a scoreboard.</p></div><div class="gsd-row"><div class="form-group"><label for="gsd-set">Question set</label><select id="gsd-set" class="dialog-select"><option value="">Select a question set...</option><option value="platform:space">Space Trivia (12 questions)</option></select><button type="button" class="gsd-setlink">Your question sets</button></div><div class="form-group"><span class="gsd-label" id="gsd-categories-label">Categories</span><div class="category-selection"><div class="category-button-grid" role="group" aria-labelledby="gsd-categories-label"><button type="button" class="category-button " aria-pressed="false"><span class="category-name">Leadership</span><span class="category-count">(20)</span></button><button type="button" class="category-button selected" aria-pressed="true"><span class="category-name">Ops</span><span class="category-count">(27)</span></button></div><small class="dialog-help-text">1 of 2 categories · 27 questions</small></div></div></div><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-t