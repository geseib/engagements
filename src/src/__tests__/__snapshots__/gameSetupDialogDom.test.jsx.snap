// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`create, call-and-answer, with a set picked 1`] = `"<div><section class="gsd-step"><h3 class="gsd-step-h"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><label id="gsd-title-label" for="gsd-title">Name it</label></h3><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" aria-describedby="gsd-title-help" value="Q3 Offsite"><small class="dialog-help-text" id="gsd-title-help">The room sees this on the main screen and on their phones.</small></section><section class="gsd-step gsd-step--format"><h3 class="gsd-step-h" id="gsd-format-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Format</h3><span class="gsd-step-acts"><button type="button" class="gsd-btn gsd-btn--link gsd-compare-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M76,64A12,12,0,0,1,88,52H216a12,12,0,0,1,0,24H88A12,12,0,0,1,76,64Zm140,52H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24Zm0,64H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24ZM44,112a16,16,0,1,0,16,16A16,16,0,0,0,44,112Zm0-64A16,16,0,1,0,60,64,16,16,0,0,0,44,48Zm0,128a16,16,0,1,0,16,16A16,16,0,0,0,44,176Z"></path></svg> Format guide</button></span><div class="gsd-fmt-wrap gsd-fmt-wrap--chips"><div class="gsd-fmt-group gsd-fmt-group--chips" role="radiogroup" aria-labelledby="gsd-format-label"><button type="button" role="radio" aria-checked="true" aria-labelledby="gsd-fmt-call-and-answer-name" tabindex="0" class="gsd-fmt gsd-fmt--chips is-on" data-format="call-and-answer"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M172,108a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,108Zm-12,28H96a12,12,0,0,0,0,24h64a12,12,0,0,0,0-24Zm76-8A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-call-and-answer-name">Call &amp; Answer</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-trivia-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="trivia"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M252,124a60.14,60.14,0,0,0-32-53.08,52,52,0,0,0-92-32.11A52,52,0,0,0,36,70.92a60,60,0,0,0,0,106.14,52,52,0,0,0,92,32.13,52,52,0,0,0,92-32.13A60.05,60.05,0,0,0,252,124ZM88,204a28,28,0,0,1-26.85-20.07c1,0,1.89.07,2.85.07h8a12,12,0,0,0,0-24H64A36,36,0,0,1,52,90.05a12,12,0,0,0,8-11.32V72a28,28,0,0,1,56,0v60.18a51.61,51.61,0,0,0-7.2-3.85,12,12,0,1,0-9.6,22A28,28,0,0,1,88,204Zm104-44h-8a12,12,0,0,0,0,24h8c1,0,1.9,0,2.85-.07a28,28,0,1,1-38-33.61,12,12,0,1,0-9.6-22,51.61,51.61,0,0,0-7.2,3.85V72a28,28,0,0,1,56,0v6.73a12,12,0,0,0,8,11.32,36,36,0,0,1-12,70Zm16-44a12,12,0,0,1-12,12,40,40,0,0,1-40-40V84a12,12,0,0,1,24,0v4a16,16,0,0,0,16,16A12,12,0,0,1,208,116ZM100,88a40,40,0,0,1-40,40,12,12,0,0,1,0-24A16,16,0,0,0,76,88V84a12,12,0,0,1,24,0Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-trivia-name">Trivia</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-poll-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="poll"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M224,196h-4V40a12,12,0,0,0-12-12H152a12,12,0,0,0-12,12V76H96A12,12,0,0,0,84,88v36H48a12,12,0,0,0-12,12v60H32a12,12,0,0,0,0,24H224a12,12,0,0,0,0-24ZM164,52h32V196H164Zm-56,48h32v96H108ZM60,148H84v48H60Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-poll-name">Poll</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-wavelength-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="wavelength"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M225.24,174.74a12,12,0,0,1-1.58,16.89C205.49,206.71,189.06,212,174.15,212c-19.76,0-36.86-9.29-51.88-17.44-25.06-13.62-44.86-24.37-74.61.3a12,12,0,1,1-15.32-18.48c42.25-35,75-17.23,101.39-2.92,25.06,13.61,44.86,24.37,74.61-.3A12,12,0,0,1,225.24,174.74Zm-16.9-57.59c-29.75,24.67-49.55,13.91-74.61.3-26.35-14.3-59.14-32.11-101.39,2.92a12,12,0,0,0,15.32,18.48c29.75-24.67,49.55-13.92,74.61-.3,15,8.15,32.12,17.44,51.88,17.44,14.91,0,31.34-5.29,49.51-20.36a12,12,0,0,0-15.32-18.48ZM47.66,82.84c29.75-24.67,49.55-13.92,74.61-.3,15,8.15,32.12,17.44,51.88,17.44,14.91,0,31.34-5.29,49.51-20.36a12,12,0,0,0-15.32-18.48c-29.75,24.67-49.55,13.92-74.61.3-26.35-14.3-59.14-32.11-101.39,2.93A12,12,0,1,0,47.66,82.84Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-wavelength-name">Wavelength</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-survey-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="survey"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M228,128a12,12,0,0,1-12,12H128a12,12,0,0,1,0-24h88A12,12,0,0,1,228,128ZM128,76h88a12,12,0,0,0,0-24H128a12,12,0,0,0,0,24Zm88,104H128a12,12,0,0,0,0,24h88a12,12,0,0,0,0-24ZM79.51,39.51,56,63l-7.51-7.52a12,12,0,0,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Zm0,64L56,127l-7.51-7.52a12,12,0,1,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Zm0,64L56,191l-7.51-7.52a12,12,0,1,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-survey-name">Survey</span></span></button></div></div><p class="gsd-blurb">Ask the room a question. Everyone answers on their phone, reads all the answers and votes for their favourites.</p></section></div><section class="gsd-step"><h3 class="gsd-step-h" id="gsd-set-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Question set</h3><div class="schs" data-testid="set-chooser" data-value="platform:pricing" data-theme="dark"><div class="schs-picked" role="group" aria-label="Question set"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg><b class="schs-picked-name" title="Strategic Pricing Plays">Strategic Pricing Plays</b><span class="schs-dim">47 questions</span><span class="schs-own schs-own--off" title="Managed by Engage and shared with every organisation. Copy it to make changes.">Ready-made</span><button type="button" class="schs-btn schs-push">Change</button></div></div><p class="gsd-setlinks"><button type="button" class="gsd-setlink">Your question sets</button><span aria-hidden="true"> · </span><button type="button" class="gsd-setlink">Make a new set</button></p></section><div class="form-group gsd-cats"><div class="gsd-cats-head"><span class="gsd-label" id="gsd-categories-label">Topics in this set</span><span class="gsd-cats-hint">Switch off any you want to skip.</span></div><div class="category-selection"><div class="category-button-grid" role="group" aria-labelledby="gsd-categories-label"><button type="button" class="category-button " aria-pressed="false" aria-label="Leadership, 20 questions"><span class="category-mark" aria-hidden="true">–</span><span class="category-name">Leadership</span><span class="category-count">20</span></button><button type="button" class="category-button selected" aria-pressed="true" aria-label="Ops, 27 questions"><span class="category-mark" aria-hidden="true">✓</span><span class="category-name">Ops</span><span class="category-count">27</span></button></div><small class="dialog-help-text" aria-live="polite">1 of 2 topics · 27 questions</small></div></div><div class="gsd-namesline" data-testid="gsd-namesline"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M56.88,31.93A12,12,0,1,0,39.12,48.07l16,17.65C20.67,88.66,5.72,121.58,5,123.13a12.08,12.08,0,0,0,0,9.75c.37.82,9.13,20.26,28.49,39.61C59.37,198.34,92,212,128,212a131.34,131.34,0,0,0,51-10l20.09,22.1a12,12,0,0,0,17.76-16.14ZM128,188c-29.59,0-55.47-10.73-76.91-31.88A130.69,130.69,0,0,1,29.52,128c5.27-9.31,18.79-29.9,42-44.29l90.09,99.11A109.33,109.33,0,0,1,128,188Zm123-55.12c-.36.81-9,20-28,39.16a12,12,0,1,1-17-16.9A130.48,130.48,0,0,0,226.48,128a130.36,130.36,0,0,0-21.57-28.12C183.46,78.73,157.59,68,128,68c-3.35,0-6.7.14-10,.42a12,12,0,1,1-2-23.91c3.93-.34,8-.51,12-.51,36,0,68.63,13.67,94.49,39.52,19.35,19.35,28.11,38.8,28.48,39.61A12.08,12.08,0,0,1,251,132.88Z"></path></svg><div><b>Names are hidden until the vote closes</b><span> While people answer and vote, nobody sees who wrote what, not even you. Names are shown with the results.</span></div><button type="button" class="gsd-btn" aria-label="Change how names are shown">Change</button></div><div><h3 class="gsd-optional-h">Optional — every one has a safe default</h3><details class="gsd-brief-fold"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Background for Workie</span><span class="gsd-adv-s">optional · add a document or write key points</span></summary><h3 class="gsd-section gsd-brief-h">Background for Workie<span class="gsd-tag">optional</span></h3><p class="gsd-brief-intro">Workie is Engage’s AI assistant: after each round it sums up what the room said. Background makes that summary speak to your situation.</p><div class="gsd-brief"><input type="file" accept=".pdf,.docx,.txt,.md,.pptx,.ppt,.key,.odp" class="gsd-brief-file" tabindex="-1" aria-hidden="true"><span class="gsd-brief-ico"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M216.49,79.52l-56-56A12,12,0,0,0,152,20H56A20,20,0,0,0,36,40V216a20,20,0,0,0,20,20H200a20,20,0,0,0,20-20V88A12,12,0,0,0,216.49,79.52ZM160,57l23,23H160ZM60,212V44h76V92a12,12,0,0,0,12,12h48V212Zm112-80a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,132Zm0,40a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,172Z"></path></svg></span><div class="gsd-brief-main"><p class="gsd-brief-t">Brief Workie from a document <span class="gsd-fine">— optional</span></p><p class="gsd-brief-d">A report, a review, a plan: whatever explains the situation this session is about. Workie gets a short summary of it — you read and can edit it first — and uses it when it reflects the room’s answers. <b>People who join never see it.</b></p><div class="gsd-brief-acts"><button type="button" class="gsd-btn"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M228,144v64a12,12,0,0,1-12,12H40a12,12,0,0,1-12-12V144a12,12,0,0,1,24,0v52H204V144a12,12,0,0,1,24,0ZM96.49,80.49,116,61v83a12,12,0,0,0,24,0V61l19.51,19.52a12,12,0,1,0,17-17l-40-40a12,12,0,0,0-17,0l-40,40a12,12,0,1,0,17,17Z"></path></svg>Choose a document</button><span class="gsd-fine">PDF, Word or text · up to 4 MB</span><button type="button" class="gsd-btn gsd-btn--link">or write the key points yourself</button></div></div></div></details><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-testid="gsd-adv-summary">Using the defaults — answers anonymous until voting closes, questions shuffled; Workie adapts its voice and follows this set’s own summary approach.<span class="gsd-adv-open-only"> Change any of them here.</span></span></summary><div class="gsd-adv-body"><div class="gsd-adv-help"><button type="button" class="help-button help-button-inline help-button-small help-button-quiet" title="Help: Advanced" aria-label="Help: Advanced"><span class="help-button-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M144,180a16,16,0,1,1-16-16A16,16,0,0,1,144,180Zm92-52A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128ZM128,64c-24.26,0-44,17.94-44,40v4a12,12,0,0,0,24,0v-4c0-8.82,9-16,20-16s20,7.18,20,16-9,16-20,16a12,12,0,0,0-12,12v8a12,12,0,0,0,23.73,2.56C158.31,137.88,172,122.37,172,104,172,81.94,152.26,64,128,64Z"></path></svg></span></button></div><h3 class="gsd-section">Responses</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Anonymous responses</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Until voting closes, nobody sees who wrote which answer — not the room, not you. The room votes on the answers, not on the people. You can also reveal the names earlier if you want to.</p><div class="gsd-preview"><div class="gsd-pv"><h6>While voting</h6><p class="gsd-pv-ans">“Freeze all discretionary discounting for thirty days…”</p><p class="gsd-pv-who">Response 1</p></div><div class="gsd-pv"><h6>After voting closes</h6><p class="gsd-pv-ans">“Freeze all discretionary discounting for thirty days…”</p><p class="gsd-pv-who named">Priya Raghavan · +180 pts</p></div></div><p class="gsd-opt-else"><b>Turn it off</b> and every answer is labelled with its author from the moment voting opens.</p><p class="gsd-opt-limit">This hides names, not identities. In a small group, people may still recognise each other’s answers.</p></div><h3 class="gsd-section">Questions</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Shuffle the question order</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Questions are drawn at random from the categories you picked, rather than in the order they were written.</p></div><div class="form-group"><label for="gsd-goal">Goal</label><div class="gsd-goal"><input id="gsd-goal" class="dialog-input" inputmode="numeric" aria-describedby="gsd-goal-help" value=""><span class="gsd-goal-unit">of 47 questions</span></div><small id="gsd-goal-help" class="dialog-help-text">Blank plays until you end the session. When the room reaches the goal, the stage and the remote tell you, and you can keep going.</small></div><h3 class="gsd-section">Workie</h3><div class="form-group"><label for="gsd-persona">Workie's voice</label><select id="gsd-persona" class="dialog-select"><option value="">Adapt to the session (recommended)</option><option value="coach">Coach — warm and direct</option></select><small class="dialog-help-text">Workie reads the room and picks its own register — playful for an icebreaker, analytical for a retro.</small></div><div class="form-group"><label for="gsd-prompt">Summary approach</label><select id="gsd-prompt" class="dialog-select"><option value="">What the set says (recommended)</option><option value="lp-behavioral">LP Behavioural</option></select><small class="dialog-help-text">How Workie sums up each round on the results screen — the shape and content, where the voice is only the register. You can change it mid-session; it applies from the next round.</small></div><div class="form-group"><label for="gsd-ai-context">Instructions for Workie</label><textarea id="gsd-ai-context" placeholder="Anything Workie must always do — e.g. ‘end every round with one question for the ops leads’" class="dialog-textarea" rows="2" maxlength="500"></textarea><small class="dialog-help-text">Workie follows these in every round’s summary. Facts about the session belong in Event details, below. 0/500 characters</small></div><h3 class="gsd-section">What people see when they join</h3><div class="form-group"><label for="gsd-details">Event details</label><textarea id="gsd-details" placeholder="What this session is for, in a sentence or two." class="dialog-textarea" rows="2" maxlength="300"></textarea><small class="dialog-help-text">Shown to people on the screen they land on after joining. Workie reads it too. 0/300 characters</small></div></div></details></div>"`;

exports[`create, poll, with a set picked 1`] = `"<div><section class="gsd-step"><h3 class="gsd-step-h"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><label id="gsd-title-label" for="gsd-title">Name it</label></h3><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" aria-describedby="gsd-title-help" value="Q3 Offsite"><small class="dialog-help-text" id="gsd-title-help">The room sees this on the main screen and on their phones.</small></section><section class="gsd-step gsd-step--format"><h3 class="gsd-step-h" id="gsd-format-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Format</h3><span class="gsd-step-acts"><button type="button" class="gsd-btn gsd-btn--link gsd-compare-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M76,64A12,12,0,0,1,88,52H216a12,12,0,0,1,0,24H88A12,12,0,0,1,76,64Zm140,52H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24Zm0,64H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24ZM44,112a16,16,0,1,0,16,16A16,16,0,0,0,44,112Zm0-64A16,16,0,1,0,60,64,16,16,0,0,0,44,48Zm0,128a16,16,0,1,0,16,16A16,16,0,0,0,44,176Z"></path></svg> Format guide</button></span><div class="gsd-fmt-wrap gsd-fmt-wrap--chips"><div class="gsd-fmt-group gsd-fmt-group--chips" role="radiogroup" aria-labelledby="gsd-format-label"><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-call-and-answer-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="call-and-answer"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M172,108a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,108Zm-12,28H96a12,12,0,0,0,0,24h64a12,12,0,0,0,0-24Zm76-8A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-call-and-answer-name">Call &amp; Answer</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-trivia-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="trivia"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M252,124a60.14,60.14,0,0,0-32-53.08,52,52,0,0,0-92-32.11A52,52,0,0,0,36,70.92a60,60,0,0,0,0,106.14,52,52,0,0,0,92,32.13,52,52,0,0,0,92-32.13A60.05,60.05,0,0,0,252,124ZM88,204a28,28,0,0,1-26.85-20.07c1,0,1.89.07,2.85.07h8a12,12,0,0,0,0-24H64A36,36,0,0,1,52,90.05a12,12,0,0,0,8-11.32V72a28,28,0,0,1,56,0v60.18a51.61,51.61,0,0,0-7.2-3.85,12,12,0,1,0-9.6,22A28,28,0,0,1,88,204Zm104-44h-8a12,12,0,0,0,0,24h8c1,0,1.9,0,2.85-.07a28,28,0,1,1-38-33.61,12,12,0,1,0-9.6-22,51.61,51.61,0,0,0-7.2,3.85V72a28,28,0,0,1,56,0v6.73a12,12,0,0,0,8,11.32,36,36,0,0,1-12,70Zm16-44a12,12,0,0,1-12,12,40,40,0,0,1-40-40V84a12,12,0,0,1,24,0v4a16,16,0,0,0,16,16A12,12,0,0,1,208,116ZM100,88a40,40,0,0,1-40,40,12,12,0,0,1,0-24A16,16,0,0,0,76,88V84a12,12,0,0,1,24,0Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-trivia-name">Trivia</span></span></button><button type="button" role="radio" aria-checked="true" aria-labelledby="gsd-fmt-poll-name" tabindex="0" class="gsd-fmt gsd-fmt--chips is-on" data-format="poll"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M224,196h-4V40a12,12,0,0,0-12-12H152a12,12,0,0,0-12,12V76H96A12,12,0,0,0,84,88v36H48a12,12,0,0,0-12,12v60H32a12,12,0,0,0,0,24H224a12,12,0,0,0,0-24ZM164,52h32V196H164Zm-56,48h32v96H108ZM60,148H84v48H60Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-poll-name">Poll</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-wavelength-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="wavelength"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M225.24,174.74a12,12,0,0,1-1.58,16.89C205.49,206.71,189.06,212,174.15,212c-19.76,0-36.86-9.29-51.88-17.44-25.06-13.62-44.86-24.37-74.61.3a12,12,0,1,1-15.32-18.48c42.25-35,75-17.23,101.39-2.92,25.06,13.61,44.86,24.37,74.61-.3A12,12,0,0,1,225.24,174.74Zm-16.9-57.59c-29.75,24.67-49.55,13.91-74.61.3-26.35-14.3-59.14-32.11-101.39,2.92a12,12,0,0,0,15.32,18.48c29.75-24.67,49.55-13.92,74.61-.3,15,8.15,32.12,17.44,51.88,17.44,14.91,0,31.34-5.29,49.51-20.36a12,12,0,0,0-15.32-18.48ZM47.66,82.84c29.75-24.67,49.55-13.92,74.61-.3,15,8.15,32.12,17.44,51.88,17.44,14.91,0,31.34-5.29,49.51-20.36a12,12,0,0,0-15.32-18.48c-29.75,24.67-49.55,13.92-74.61.3-26.35-14.3-59.14-32.11-101.39,2.93A12,12,0,1,0,47.66,82.84Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-wavelength-name">Wavelength</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-survey-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="survey"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M228,128a12,12,0,0,1-12,12H128a12,12,0,0,1,0-24h88A12,12,0,0,1,228,128ZM128,76h88a12,12,0,0,0,0-24H128a12,12,0,0,0,0,24Zm88,104H128a12,12,0,0,0,0,24h88a12,12,0,0,0,0-24ZM79.51,39.51,56,63l-7.51-7.52a12,12,0,0,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Zm0,64L56,127l-7.51-7.52a12,12,0,1,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Zm0,64L56,191l-7.51-7.52a12,12,0,1,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-survey-name">Survey</span></span></button></div></div><p class="gsd-blurb">Ask a quick question: pick one, rate it, yes or no, or a few words. The results fill in live on the big screen.</p></section></div><section class="gsd-step"><h3 class="gsd-step-h" id="gsd-set-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Question set</h3><div class="schs" data-testid="set-chooser" data-value="platform:mood" data-theme="dark"><div class="schs-picked" role="group" aria-label="Question set"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg><b class="schs-picked-name" title="Room Mood">Room Mood</b><span class="schs-dim">6 questions</span><span class="schs-own schs-own--off" title="Managed by Engage and shared with every organisation. Copy it to make changes.">Ready-made</span><button type="button" class="schs-btn schs-push">Change</button></div></div><p class="gsd-setlinks"><button type="button" class="gsd-setlink">Your question sets</button><span aria-hidden="true"> · </span><button type="button" class="gsd-setlink">Make a new set</button></p></section><div class="form-group gsd-cats"><div class="gsd-cats-head"><span class="gsd-label" id="gsd-categories-label">Topics in this set</span><span class="gsd-cats-hint">Switch off any you want to skip.</span></div><div class="category-selection"><div class="category-button-grid" role="group" aria-labelledby="gsd-categories-label"><button type="button" class="category-button " aria-pressed="false" aria-label="Leadership, 20 questions"><span class="category-mark" aria-hidden="true">–</span><span class="category-name">Leadership</span><span class="category-count">20</span></button><button type="button" class="category-button selected" aria-pressed="true" aria-label="Ops, 27 questions"><span class="category-mark" aria-hidden="true">✓</span><span class="category-name">Ops</span><span class="category-count">27</span></button></div><small class="dialog-help-text" aria-live="polite">1 of 2 topics · 27 questions</small></div></div><div><h3 class="gsd-optional-h">Optional — every one has a safe default</h3><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-testid="gsd-adv-summary">Using the defaults — questions shuffled; Workie adapts its voice and gives the standard Poll summary.<span class="gsd-adv-open-only"> Change any of them here.</span></span></summary><div class="gsd-adv-body"><div class="gsd-adv-help"><button type="button" class="help-button help-button-inline help-button-small help-button-quiet" title="Help: Advanced" aria-label="Help: Advanced"><span class="help-button-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M144,180a16,16,0,1,1-16-16A16,16,0,0,1,144,180Zm92-52A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128ZM128,64c-24.26,0-44,17.94-44,40v4a12,12,0,0,0,24,0v-4c0-8.82,9-16,20-16s20,7.18,20,16-9,16-20,16a12,12,0,0,0-12,12v8a12,12,0,0,0,23.73,2.56C158.31,137.88,172,122.37,172,104,172,81.94,152.26,64,128,64Z"></path></svg></span></button></div><h3 class="gsd-section">Questions</h3><div class="gsd-opt is-on"><label class="gsd-opt-head"><input type="checkbox" checked=""><span class="gsd-opt-name">Shuffle the question order</span><span class="gsd-opt-state" aria-hidden="true">On</span></label><p class="gsd-opt-does">Questions are drawn at random from the categories you picked, rather than in the order they were written.</p></div><div class="form-group"><label for="gsd-goal">Goal</label><div class="gsd-goal"><input id="gsd-goal" class="dialog-input" inputmode="numeric" aria-describedby="gsd-goal-help" value=""><span class="gsd-goal-unit">of 6 questions</span></div><small id="gsd-goal-help" class="dialog-help-text">Blank plays until you end the session. When the room reaches the goal, the stage and the remote tell you, and you can keep going.</small></div><h3 class="gsd-section">Workie</h3><div class="form-group"><label for="gsd-persona">Workie's voice</label><select id="gsd-persona" class="dialog-select"><option value="">Adapt to the session (recommended)</option><option value="coach">Coach — warm and direct</option></select><small class="dialog-help-text">Workie reads the room and picks its own register — playful for an icebreaker, analytical for a retro.</small></div><div class="form-group"><label for="gsd-prompt">Summary approach</label><select id="gsd-prompt" class="dialog-select"><option value="">The standard Poll way (recommended)</option></select><small class="dialog-help-text">How Workie sums up each round on the results screen — the shape and content, where the voice is only the register. You can change it mid-session; it applies from the next round.</small></div><div class="form-group"><label for="gsd-ai-context">Instructions for Workie</label><textarea id="gsd-ai-context" placeholder="Anything Workie must always do — e.g. ‘end every round with one question for the ops leads’" class="dialog-textarea" rows="2" maxlength="500"></textarea><small class="dialog-help-text">Workie follows these in every round’s summary. Facts about the session belong in Event details, below. 0/500 characters</small></div><h3 class="gsd-section">What people see when they join</h3><div class="form-group"><label for="gsd-details">Event details</label><textarea id="gsd-details" placeholder="What this session is for, in a sentence or two." class="dialog-textarea" rows="2" maxlength="300"></textarea><small class="dialog-help-text">Shown to people on the screen they land on after joining. Workie reads it too. 0/300 characters</small></div></div></details></div>"`;

exports[`create, survey, with a set picked 1`] = `"<div><section class="gsd-step"><h3 class="gsd-step-h"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><label id="gsd-title-label" for="gsd-title">Name it</label></h3><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" aria-describedby="gsd-title-help" value="Q3 Offsite"><small class="dialog-help-text" id="gsd-title-help">The room sees this on the main screen and on their phones.</small></section><section class="gsd-step gsd-step--format"><h3 class="gsd-step-h" id="gsd-format-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Format</h3><span class="gsd-step-acts"><button type="button" class="gsd-btn gsd-btn--link gsd-compare-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M76,64A12,12,0,0,1,88,52H216a12,12,0,0,1,0,24H88A12,12,0,0,1,76,64Zm140,52H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24Zm0,64H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24ZM44,112a16,16,0,1,0,16,16A16,16,0,0,0,44,112Zm0-64A16,16,0,1,0,60,64,16,16,0,0,0,44,48Zm0,128a16,16,0,1,0,16,16A16,16,0,0,0,44,176Z"></path></svg> Format guide</button></span><div class="gsd-fmt-wrap gsd-fmt-wrap--chips"><div class="gsd-fmt-group gsd-fmt-group--chips" role="radiogroup" aria-labelledby="gsd-format-label"><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-call-and-answer-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="call-and-answer"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M172,108a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,108Zm-12,28H96a12,12,0,0,0,0,24h64a12,12,0,0,0,0-24Zm76-8A108,108,0,0,1,78.77,224.15L46.34,235A20,20,0,0,1,21,209.66l10.81-32.43A108,108,0,1,1,236,128Zm-24,0A84,84,0,1,0,55.27,170.06a12,12,0,0,1,1,9.81l-9.93,29.79,29.79-9.93a12.1,12.1,0,0,1,3.8-.62,12,12,0,0,1,6,1.62A84,84,0,0,0,212,128Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-call-and-answer-name">Call &amp; Answer</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-trivia-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="trivia"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M252,124a60.14,60.14,0,0,0-32-53.08,52,52,0,0,0-92-32.11A52,52,0,0,0,36,70.92a60,60,0,0,0,0,106.14,52,52,0,0,0,92,32.13,52,52,0,0,0,92-32.13A60.05,60.05,0,0,0,252,124ZM88,204a28,28,0,0,1-26.85-20.07c1,0,1.89.07,2.85.07h8a12,12,0,0,0,0-24H64A36,36,0,0,1,52,90.05a12,12,0,0,0,8-11.32V72a28,28,0,0,1,56,0v60.18a51.61,51.61,0,0,0-7.2-3.85,12,12,0,1,0-9.6,22A28,28,0,0,1,88,204Zm104-44h-8a12,12,0,0,0,0,24h8c1,0,1.9,0,2.85-.07a28,28,0,1,1-38-33.61,12,12,0,1,0-9.6-22,51.61,51.61,0,0,0-7.2,3.85V72a28,28,0,0,1,56,0v6.73a12,12,0,0,0,8,11.32,36,36,0,0,1-12,70Zm16-44a12,12,0,0,1-12,12,40,40,0,0,1-40-40V84a12,12,0,0,1,24,0v4a16,16,0,0,0,16,16A12,12,0,0,1,208,116ZM100,88a40,40,0,0,1-40,40,12,12,0,0,1,0-24A16,16,0,0,0,76,88V84a12,12,0,0,1,24,0Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-trivia-name">Trivia</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-poll-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="poll"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M224,196h-4V40a12,12,0,0,0-12-12H152a12,12,0,0,0-12,12V76H96A12,12,0,0,0,84,88v36H48a12,12,0,0,0-12,12v60H32a12,12,0,0,0,0,24H224a12,12,0,0,0,0-24ZM164,52h32V196H164Zm-56,48h32v96H108ZM60,148H84v48H60Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-poll-name">Poll</span></span></button><button type="button" role="radio" aria-checked="false" aria-labelledby="gsd-fmt-wavelength-name" tabindex="-1" class="gsd-fmt gsd-fmt--chips" data-format="wavelength"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M225.24,174.74a12,12,0,0,1-1.58,16.89C205.49,206.71,189.06,212,174.15,212c-19.76,0-36.86-9.29-51.88-17.44-25.06-13.62-44.86-24.37-74.61.3a12,12,0,1,1-15.32-18.48c42.25-35,75-17.23,101.39-2.92,25.06,13.61,44.86,24.37,74.61-.3A12,12,0,0,1,225.24,174.74Zm-16.9-57.59c-29.75,24.67-49.55,13.91-74.61.3-26.35-14.3-59.14-32.11-101.39,2.92a12,12,0,0,0,15.32,18.48c29.75-24.67,49.55-13.92,74.61-.3,15,8.15,32.12,17.44,51.88,17.44,14.91,0,31.34-5.29,49.51-20.36a12,12,0,0,0-15.32-18.48ZM47.66,82.84c29.75-24.67,49.55-13.92,74.61-.3,15,8.15,32.12,17.44,51.88,17.44,14.91,0,31.34-5.29,49.51-20.36a12,12,0,0,0-15.32-18.48c-29.75,24.67-49.55,13.92-74.61.3-26.35-14.3-59.14-32.11-101.39,2.93A12,12,0,1,0,47.66,82.84Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-wavelength-name">Wavelength</span></span></button><button type="button" role="radio" aria-checked="true" aria-labelledby="gsd-fmt-survey-name" tabindex="0" class="gsd-fmt gsd-fmt--chips is-on" data-format="survey"><span class="gsd-fmt-top"><span class="gsd-fmt-mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M228,128a12,12,0,0,1-12,12H128a12,12,0,0,1,0-24h88A12,12,0,0,1,228,128ZM128,76h88a12,12,0,0,0,0-24H128a12,12,0,0,0,0,24Zm88,104H128a12,12,0,0,0,0,24h88a12,12,0,0,0,0-24ZM79.51,39.51,56,63l-7.51-7.52a12,12,0,0,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Zm0,64L56,127l-7.51-7.52a12,12,0,1,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Zm0,64L56,191l-7.51-7.52a12,12,0,1,0-17,17l16,16a12,12,0,0,0,17,0l32-32a12,12,0,0,0-17-17Z"></path></svg><span class="gsd-fmt-name" id="gsd-fmt-survey-name">Survey</span></span></button></div></div><p class="gsd-blurb">Send a short form people fill in on their phones, in their own time. You see the answers added up.</p></section></div><section class="gsd-step"><h3 class="gsd-step-h" id="gsd-set-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Question set</h3><div class="schs" data-testid="set-chooser" data-value="platform:pulse" data-theme="dark"><div class="schs-picked" role="group" aria-label="Question set"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg><b class="schs-picked-name" title="Kickoff pulse">Kickoff pulse</b><span class="schs-dim">5 questions</span><span class="schs-own schs-own--off" title="Managed by Engage and shared with every organisation. Copy it to make changes.">Ready-made</span><button type="button" class="schs-btn schs-push">Change</button></div></div><p class="gsd-setlinks"><button type="button" class="gsd-setlink">Your question sets</button><span aria-hidden="true"> · </span><button type="button" class="gsd-setlink">Make a new set</button></p></section><div class="gsd-namesline is-compact" data-testid="gsd-namesline"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M56.88,31.93A12,12,0,1,0,39.12,48.07l16,17.65C20.67,88.66,5.72,121.58,5,123.13a12.08,12.08,0,0,0,0,9.75c.37.82,9.13,20.26,28.49,39.61C59.37,198.34,92,212,128,212a131.34,131.34,0,0,0,51-10l20.09,22.1a12,12,0,0,0,17.76-16.14ZM128,188c-29.59,0-55.47-10.73-76.91-31.88A130.69,130.69,0,0,1,29.52,128c5.27-9.31,18.79-29.9,42-44.29l90.09,99.11A109.33,109.33,0,0,1,128,188Zm123-55.12c-.36.81-9,20-28,39.16a12,12,0,1,1-17-16.9A130.48,130.48,0,0,0,226.48,128a130.36,130.36,0,0,0-21.57-28.12C183.46,78.73,157.59,68,128,68c-3.35,0-6.7.14-10,.42a12,12,0,1,1-2-23.91c3.93-.34,8-.51,12-.51,36,0,68.63,13.67,94.49,39.52,19.35,19.35,28.11,38.8,28.48,39.61A12.08,12.08,0,0,1,251,132.88Z"></path></svg><div><b>Names: Who finished</b> · locked when it opens</div><button type="button" class="gsd-btn" aria-label="Change the names rule">Change</button></div><div><h3 class="gsd-optional-h">Optional — every one has a safe default</h3><details class="gsd-adv"><summary><span class="gsd-adv-k"><i class="gsd-chev" aria-hidden="true"></i>Advanced</span><span class="gsd-adv-s" data-testid="gsd-adv-summary">Using the defaults — who finished recorded, never their answers (this set’s default).<span class="gsd-adv-open-only"> Change any of them here.</span></span></summary><div class="gsd-adv-body"><div class="gsd-adv-help"><button type="button" class="help-button help-button-inline help-button-small help-button-quiet" title="Help: Advanced" aria-label="Help: Advanced"><span class="help-button-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M144,180a16,16,0,1,1-16-16A16,16,0,0,1,144,180Zm92-52A108,108,0,1,1,128,20,108.12,108.12,0,0,1,236,128Zm-24,0a84,84,0,1,0-84,84A84.09,84.09,0,0,0,212,128ZM128,64c-24.26,0-44,17.94-44,40v4a12,12,0,0,0,24,0v-4c0-8.82,9-16,20-16s20,7.18,20,16-9,16-20,16a12,12,0,0,0-12,12v8a12,12,0,0,0,23.73,2.56C158.31,137.88,172,122.37,172,104,172,81.94,152.26,64,128,64Z"></path></svg></span></button></div><h3 class="gsd-section">Responses</h3><div class="gsd-names"><div class="gsd-names-hd"><span class="gsd-opt-name">Names</span><span class="gsd-names-st" aria-hidden="true">Who finished</span></div><div class="gsd-three" role="radiogroup" aria-label="Names"><button type="button" role="radio" aria-checked="false" tabindex="-1" class="gsd-three-opt"><b><i aria-hidden="true"></i>Anonymous</b><span>Nobody is recorded. The host sees totals and the words people write.</span></button><button type="button" role="radio" aria-checked="true" tabindex="0" class="gsd-three-opt"><b><i aria-hidden="true"></i>Who finished</b><span>The host sees who finished, never what they answered.</span></button><button type="button" role="radio" aria-checked="false" tabindex="-1" class="gsd-three-opt"><b><i aria-hidden="true"></i>Named</b><span>The host sees each person’s name with their answers. The room never does.</span></button></div><p class="gsd-opt-does">You will see a list of who finished and who stopped partway. Their answers are stored apart from their names, so nobody — you included — can match an answer to a person.</p><div class="gsd-preview"><div class="gsd-pv"><h6>What their phone says</h6><p class="gsd-pv-ans" data-testid="names-phone-preview">Your host sees that you finished — not what you answered.</p></div><div class="gsd-pv"><h6>What you get</h6><p class="gsd-pv-ans">“Seeing the console actually run beat every slide about it.”</p><p class="gsd-pv-who">Response 12 · no name</p><p class="gsd-pv-ans gsd-pv-gap">Priya Raghavan · finished 2:12pm</p><p class="gsd-pv-who">People list · no answers</p></div></div><p class="gsd-opt-limit">This hides names, not identities. In a small group, people may still recognise each other’s answers.</p></div><p class="gsd-names-lock"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M208,76H180V56A52,52,0,0,0,76,56V76H48A20,20,0,0,0,28,96V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V96A20,20,0,0,0,208,76ZM100,56a28,28,0,0,1,56,0V76H100ZM204,204H52V100H204Zm-60-52a16,16,0,1,1-16-16A16,16,0,0,1,144,152Z"></path></svg> Fixed once the survey opens — people answer on the promise their phone made them. This set’s default is <b>Who finished</b>.</p><h3 class="gsd-section">Workie</h3><div class="form-group"><label for="gsd-persona">Workie's voice</label><select id="gsd-persona" class="dialog-select"><option value="">Adapt to the session (recommended)</option><option value="coach">Coach — warm and direct</option></select><small class="dialog-help-text">Workie reads the room and picks its own register — playful for an icebreaker, analytical for a retro.</small></div><div class="form-group"><label for="gsd-prompt">Summary approach</label><select id="gsd-prompt" class="dialog-select"><option value="">The standard Survey way (recommended)</option></select><small class="dialog-help-text">How Workie sums up each round on the results screen — the shape and content, where the voice is only the register. You can change it mid-session; it applies from the next round.</small></div><div class="form-group"><label for="gsd-ai-context">Instructions for Workie</label><textarea id="gsd-ai-context" placeholder="Anything Workie must always do — e.g. ‘end every round with one question for the ops leads’" class="dialog-textarea" rows="2" maxlength="500"></textarea><small class="dialog-help-text">Workie follows these in every round’s summary. Facts about the session belong in Event details, below. 0/500 characters</small></div><h3 class="gsd-section">What people see when they join</h3><div class="form-group"><label for="gsd-details">Event details</label><textarea id="gsd-details" placeholder="What this session is for, in a sentence or two." class="dialog-textarea" rows="2" maxlength="300"></textarea><small class="dialog-help-text">Shown to people on the screen they land on after joining. Workie reads it too. 0/300 characters</small></div></div></details></div>"`;

exports[`create, trivia, with a set picked 1`] = `"<div><section class="gsd-step"><h3 class="gsd-step-h"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span><label id="gsd-title-label" for="gsd-title">Name it</label></h3><input id="gsd-title" type="text" placeholder="e.g. Q3 Leadership Offsite — Pricing Strategy" class="dialog-input" aria-describedby="gsd-title-help" value="Q3 Offsite"><small class="dialog-help-text" id="gsd-title-help">The room sees this on the main screen and on their phones.</small></section><section class="gsd-step gsd-step--format"><h3 class="gsd-step-h" id="gsd-format-label"><span class="gsd-step-n is-done" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path></svg></span>Format</h3><span class="gsd-step-acts"><button type="button" class="gsd-btn gsd-btn--link gsd-compare-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" class="ws-icon" aria-hidden="true"><path d="M76,64A12,12,0,0,1,88,52H216a12,12,0,0,1,0,24H88A12,12,0,0,1,76,64Zm140,52H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24Zm0,64H88a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24ZM44,112a16,16,0,1,0,16,16A16,16,0,0,0,44,112Zm0-64A16,16,0,1,0,60,64,16,16,0,0,0,44,48Zm0,128a16,16,0,1,0,16,16A16,16,0,0,0,44,176Z"></path></svg> Format guide</button></span><div class="gsd-fmt-wrap gsd-fmt-wrap--chips"><div class="gsd-fmt-group gsd-fmt-group--chips" role="radiogroup" aria-labelledby="gsd-format-label"><button type="button" role="radio" aria-checked="fals