# Dependencies — reproduced exactly from src/package-lock.json via `npm ci`.
node_modules/

# Build output — regenerated by `npm run build`, with content-hashed filenames
# that change on every build.
src/dist/

# Generated at deploy time by scripts/deploy-frontend-dev.sh from the
# CloudFormation stack outputs. Never commit it: it pins one environment's
# API endpoints into the repo.
src/public/config.js

# SAM / CloudFormation local state
.aws-sam/
samconfig.toml.bak

# Local environment overrides
.env
.env.local

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
npm-debug.log*
yarn-error.log*
*.log
